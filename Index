const STORAGE_KEY = 'chinese_srs_v2';
function loadWords(){const s=localStorage.getItem(STORAGE_KEY);if(s){try{return JSON.parse(s);}catch(e){}}const w=JSON.parse(JSON.stringify(DEFAULT_WORDS));saveWords(w);return w;}
function saveWords(w){localStorage.setItem(STORAGE_KEY,JSON.stringify(w));}
const MIN_EASE=1.3;
function sm2(interval,ease,r){let ni,ne;if(r===1){ni=1;ne=Math.max(MIN_EASE,ease-0.2);}else if(r===2){ni=Math.max(1,Math.round(interval*1.2));ne=Math.max(MIN_EASE,ease-0.15);}else if(r===3){ni=Math.max(1,Math.round(interval*ease));ne=ease;}else{ni=Math.max(1,Math.round(interval*ease*1.3));ne=ease+0.15;}return[ni,Math.round(ne*100)/100];}
function todayStr(){const d=new Date();const y=d.getFullYear();const m=String(d.getMonth()+1).padStart(2,'0');const dd=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+dd;}
function addDays(ds,days){const d=new Date(ds+'T00:00:00');d.setDate(d.getDate()+days);const y=d.getFullYear();const m=String(d.getMonth()+1).padStart(2,'0');const dd=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+dd;}
function applyRating(word,r){const today=todayStr();let ni,ne;if(word.reps<1){ni=1;ne=word.ease;}else if(word.reps<2){ni=3;ne=word.ease;}else{[ni,ne]=sm2(word.interval,word.ease,r);}word.interval=ni;word.ease=ne;word.due=addDays(today,ni);word.reps=(word.reps||0)+1;if(r===1)word.reps=Math.max(0,word.reps-2);return word;}
let words={},sessionQueue=[],sessionIdx=0,sessionStats={again:0,hard:0,good:0,easy:0};
function showHome(){words=loadWords();const today=todayStr();const due=Object.values(words).filter(w=>w.due<=today);document.getElementById('stat-due').textContent=due.length;document.getElementById('stat-total').textContent=Object.keys(words).length;document.getElementById('today-date').textContent=today;show('screen-home');}
function startSession(){words=loadWords();const today=todayStr();sessionQueue=Object.values(words).filter(w=>w.due<=today).sort(()=>Math.random()-0.5).slice(0,50);if(!sessionQueue.length){alert('No words due! Come back tomorrow 🎉');return;}sessionIdx=0;sessionStats={again:0,hard:0,good:0,easy:0};show('screen-quiz');renderCard();}
function renderCard(){const w=sessionQueue[sessionIdx];const total=sessionQueue.length;document.getElementById('q-current').textContent=sessionIdx+1;document.getElementById('q-total').textContent=total;document.getElementById('q-progress-fill').style.width=(sessionIdx/total*100)+'%';const cardEl=document.getElementById('q-card');const reps=w.reps||0;const hasEx=w.example_zh&&w.example_zh.trim();if(reps<2||!hasEx){cardEl.innerHTML='<div class="card-label">What is the Chinese for…</div><div class="card-meaning">'+esc(w.meaning)+'</div>';}else{const blanked=w.example_zh.replace(w.chinese,'<span class="card-blank">　　　</span>');cardEl.innerHTML='<div class="card-label">Fill in the blank</div><div class="card-sentence">'+blanked+'</div><div class="card-hint">💡 '+esc(w.meaning)+'</div>';}document.getElementById('q-show-btn').classList.remove('hidden');document.getElementById('q-answer-area').classList.add('hidden');}
function showAnswer(){const w=sessionQueue[sessionIdx];document.getElementById('q-show-btn').classList.add('hidden');const hasEx=w.example_zh&&w.example_zh.trim();let extra='';if(hasEx){extra='<div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border)"><div style="font-size:15px;line-height:1.7">'+esc(w.example_zh)+'</div><div style="font-size:13px;color:var(--text2);margin-top:4px">'+esc(w.example_pinyin)+'</div><div style="font-size:12px;color:var(--text3);margin-top:2px">'+esc(w.example_en)+'</div></div>';}document.getElementById('q-answer-card').innerHTML='<div class="answer-chinese">'+esc(w.chinese)+'</div><div class="answer-pinyin">'+esc(w.pinyin)+'</div><div class="answer-meaning">'+esc(w.meaning)+'</div>'+extra;document.getElementById('q-answer-area').classList.remove('hidden');}
function rate(r){const w=sessionQueue[sessionIdx];if(r===1)sessionStats.again++;else if(r===2)sessionStats.hard++;else if(r===3)sessionStats.good++;else sessionStats.easy++;applyRating(words[w.chinese],r);saveWords(words);sessionIdx++;if(sessionIdx>=sessionQueue.length)showSummary();else renderCard();}
function endSession(){if(sessionIdx>0)showSummary();else showHome();}
function showSummary(){const today=todayStr();const tomorrow=addDays(today,1);const dt=Object.values(words).filter(w=>w.due===tomorrow).length;document.getElementById('summary-content').innerHTML=row('Reviewed',sessionIdx)+row('Again 😓',sessionStats.again,'var(--red)')+row('Hard 😅',sessionStats.hard,'var(--yellow)')+row('Good 👍',sessionStats.good,'var(--green)')+row('Easy 🚀',sessionStats.easy,'#a0a0ff')+row('Due tomorrow',dt);show('screen-summary');}
function row(l,v,c){return '<div class="summary-row"><span class="summary-label">'+l+'</span><span class="summary-val"'+(c?' style="color:'+c+'"':'')+'>'+v+'</span></div>';}
function exportData(){const w=loadWords();const blob=new Blob([JSON.stringify({words:w,last_updated:todayStr()},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='srs_data.json';a.click();}
function importData(e){const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=ev=>{try{const data=JSON.parse(ev.target.result);const w=data.words||data;saveWords(w);showHome();alert('Imported '+Object.keys(w).length+' words!');}catch(err){alert('Invalid JSON file.');}};reader.readAsText(file);e.target.value='';}
function show(id){['screen-home','screen-quiz','screen-summary'].forEach(s=>document.getElementById(s).classList.toggle('hidden',s!==id));}
function esc(s){if(!s)return '';return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
showHome();
