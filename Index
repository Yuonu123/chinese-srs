<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="Chinese SRS">
<title>Chinese SRS</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
:root{--bg:#0f0f13;--card:#1a1a24;--card2:#22222f;--accent:#6c63ff;--accent2:#4ecdc4;--text:#f0f0f5;--text2:#9090a8;--text3:#5a5a7a;--border:#2a2a3a;--red:#ff6b6b;--yellow:#ffd93d;--green:#6bcb77;--r:16px;}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;min-height:100vh;display:flex;flex-direction:column;}
#app{flex:1;display:flex;flex-direction:column;max-width:480px;margin:0 auto;width:100%;padding:0 16px;}
.home{flex:1;display:flex;flex-direction:column;justify-content:center;gap:24px;padding:32px 0;}
.home-title{font-size:28px;font-weight:700;letter-spacing:-0.5px;}
.home-title span{color:var(--accent);}
.stats-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.stat-card{background:var(--card);border-radius:var(--r);padding:20px;text-align:center;border:1px solid var(--border);}
.stat-num{font-size:36px;font-weight:700;color:var(--accent);}
.stat-label{font-size:13px;color:var(--text2);margin-top:4px;}
.btn{display:block;width:100%;padding:18px;border-radius:var(--r);border:none;font-size:17px;font-weight:600;cursor:pointer;transition:opacity 0.15s,transform 0.1s;}
.btn:active{transform:scale(0.97);opacity:0.85;}
.btn-primary{background:var(--accent);color:#fff;}
.btn-secondary{background:var(--card);color:var(--text);border:1px solid var(--border);}
.home-actions{display:flex;flex-direction:column;gap:10px;}
.version{text-align:center;color:var(--text3);font-size:12px;margin-top:8px;}
.quiz{flex:1;display:flex;flex-direction:column;gap:0;padding-top:16px;}
.quiz-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.quiz-progress{font-size:13px;color:var(--text2);}
.quiz-exit{background:none;border:none;color:var(--text3);font-size:14px;cursor:pointer;padding:4px 8px;}
.progress-bar{height:4px;background:var(--border);border-radius:2px;margin-bottom:20px;overflow:hidden;}
.progress-fill{height:100%;background:var(--accent);border-radius:2px;transition:width 0.3s;}
.card{background:var(--card);border-radius:var(--r);padding:24px;border:1px solid var(--border);margin-bottom:16px;}
.card-label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-bottom:12px;}
.card-meaning{font-size:22px;font-weight:600;line-height:1.4;}
.card-sentence{font-size:18px;line-height:1.6;}
.card-blank{display:inline-block;background:var(--accent);color:transparent;border-radius:4px;min-width:60px;}
.card-hint{font-size:14px;color:var(--accent2);margin-top:10px;}
.answer-card{background:var(--card2);border-radius:var(--r);padding:24px;border:1px solid var(--border);margin-bottom:16px;}
.answer-chinese{font-size:40px;font-weight:700;text-align:center;letter-spacing:4px;}
.answer-pinyin{text-align:center;color:var(--text2);margin-top:8px;font-size:16px;}
.answer-meaning{text-align:center;color:var(--text3);margin-top:4px;font-size:14px;}
.show-btn{background:var(--card2);border:1px solid var(--accent);color:var(--accent);border-radius:var(--r);padding:18px;font-size:17px;font-weight:600;cursor:pointer;width:100%;margin-bottom:16px;transition:background 0.15s;}
.show-btn:active{background:var(--accent);color:#fff;}
.rating-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.rating-btn{padding:16px;border-radius:var(--r);border:none;font-size:15px;font-weight:600;cursor:pointer;transition:opacity 0.15s,transform 0.1s;}
.rating-btn:active{transform:scale(0.96);opacity:0.8;}
.r1{background:#3a1a1a;color:var(--red);}
.r2{background:#2a2a1a;color:var(--yellow);}
.r3{background:#1a2a1a;color:var(--green);}
.r4{background:#1a1a3a;color:#a0a0ff;}
.summary{flex:1;display:flex;flex-direction:column;justify-content:center;gap:20px;padding:32px 0;}
.summary-title{font-size:26px;font-weight:700;text-align:center;}
.summary-card{background:var(--card);border-radius:var(--r);padding:20px;border:1px solid var(--border);}
.summary-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);}
.summary-row:last-child{border-bottom:none;}
.summary-label{color:var(--text2);font-size:15px;}
.summary-val{font-size:15px;font-weight:600;}
.hidden{display:none!important;}
</style>
</head>
<body>
<div id="app">
<div id="screen-home" class="home">
  <div>
    <div class="home-title">Chinese <span>SRS</span></div>
    <div style="color:var(--text2);margin-top:6px;font-size:15px;">Spaced repetition flashcards</div>
  </div>
  <div class="stats-row">
    <div class="stat-card"><div class="stat-num" id="stat-due">—</div><div class="stat-label">Due today</div></div>
    <div class="stat-card"><div class="stat-num" id="stat-total">—</div><div class="stat-label">Total words</div></div>
  </div>
  <div class="home-actions">
    <button class="btn btn-primary" onclick="startSession()">Study Now</button>
    <button class="btn btn-secondary" onclick="exportData()">Export JSON (backup)</button>
    <button class="btn btn-secondary" onclick="document.getElementById('import-input').click()">Import JSON</button>
    <input type="file" id="import-input" accept=".json" style="display:none" onchange="importData(event)">
  </div>
  <div class="version">Joshua's Chinese SRS · <span id="today-date"></span></div>
</div>
<div id="screen-quiz" class="quiz hidden">
  <div class="quiz-header">
    <div class="quiz-progress"><span id="q-current">1</span> / <span id="q-total">0</span></div>
    <button class="quiz-exit" onclick="endSession()">✕ End</button>
  </div>
  <div class="progress-bar"><div class="progress-fill" id="q-progress-fill"></div></div>
  <div class="card" id="q-card"></div>
  <button class="show-btn hidden" id="q-show-btn" onclick="showAnswer()">Show Answer</button>
  <div id="q-answer-area" class="hidden">
    <div class="answer-card" id="q-answer-card"></div>
    <div class="rating-grid">
      <button class="rating-btn r1" onclick="rate(1)">1 — Again</button>
      <button class="rating-btn r2" onclick="rate(2)">2 — Hard</button>
      <button class="rating-btn r3" onclick="rate(3)">3 — Good</button>
      <button class="rating-btn r4" onclick="rate(4)">4 — Easy</button>
    </div>
  </div>
</div>
<div id="screen-summary" class="summary hidden">
  <div style="text-align:center;font-size:48px;">🎉</div>
  <div class="summary-title">Session Complete!</div>
  <div class="summary-card" id="summary-content"></div>
  <button class="btn btn-primary" style="margin-top:8px" onclick="showHome()">Back to Home</button>
</div>
</div>
<script>
const DEFAULT_WORDS = {"局外人": {"chinese": "局外人", "pinyin": "jú wài rén", "meaning": "outsider; bystander", "example_zh": "他在这个团队里感觉自己像个局外人。", "example_pinyin": "Tā zài zhège tuánduì lǐ gǎnjué zìjǐ xiàng gè jú wài rén.", "example_en": "He feels like an outsider in this team.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "纠葛": {"chinese": "纠葛", "pinyin": "jiū gé", "meaning": "entanglement; dispute; involvement", "example_zh": "他们之间的纠葛很难解决。", "example_pinyin": "Tāmen zhījiān de jiū gé hěn nán jiějué.", "example_en": "The entanglement between them is hard to resolve.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "敏锐": {"chinese": "敏锐", "pinyin": "mǐn ruì", "meaning": "sharp, keen, acute", "example_zh": "她有敏锐的观察力，总能发现别人忽略的细节。", "example_pinyin": "Tā yǒu mǐnruì de guānchálì, zǒng néng fāxiàn biérén hūlüè de xìjié.", "example_en": "She has a keen sense of observation and always notices details others overlook.", "interval": 8, "ease": 2.5, "due": "2026-06-19", "reps": 3}, "恶意": {"chinese": "恶意", "pinyin": "èyì", "meaning": "malice; malicious intent; ill will", "example_zh": "他的话充满了恶意。", "example_pinyin": "Tā de huà chōngmǎn le èyì.", "example_en": "His words were full of malice.", "interval": 10, "ease": 2.65, "due": "2026-06-17", "reps": 3}, "客观": {"chinese": "客观", "pinyin": "kè guān", "meaning": "objective; impartial", "example_zh": "我们需要客观地看待这个问题。", "example_pinyin": "Wǒmen xūyào kèguān de kàndài zhège wèntí.", "example_en": "We need to look at this issue objectively.", "interval": 4, "ease": 2.35, "due": "2026-06-11", "reps": 3}, "辈分": {"chinese": "辈分", "pinyin": "bèi fèn", "meaning": "seniority in family hierarchy; generational rank", "example_zh": "在中国家庭里，辈分很重要。", "example_pinyin": "Zài Zhōngguó jiātíng lǐ, bèifèn hěn zhòngyào.", "example_en": "In Chinese families, generational rank is very important.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "级别": {"chinese": "级别", "pinyin": "jí bié", "meaning": "level; rank; grade", "example_zh": "他的职位级别比我高。", "example_pinyin": "Tā de zhíwèi jíbié bǐ wǒ gāo.", "example_en": "His job rank is higher than mine.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "老光棍": {"chinese": "老光棍", "pinyin": "lǎo guāng gùn", "meaning": "old bachelor; confirmed bachelor; lifelong single man", "example_zh": "他四十岁了还没结婚，大家都叫他老光棍。", "example_pinyin": "Tā sìshí suì le hái méi jiéhūn, dàjiā dōu jiào tā lǎo guānggùn.", "example_en": "He is forty and still unmarried — everyone calls him an old bachelor.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "割裂": {"chinese": "割裂", "pinyin": "gē liè", "meaning": "to separate; to sever; to split apart", "example_zh": "不能把理论和实践割裂开来。", "example_pinyin": "Bù néng bǎ lǐlùn hé shíjiàn gēliè kāilái.", "example_en": "You cannot separate theory from practice.", "interval": 4, "ease": 2.35, "due": "2026-06-11", "reps": 3}, "外资企业": {"chinese": "外资企业", "pinyin": "wài zī qǐ yè", "meaning": "foreign-funded enterprise; foreign-invested company", "example_zh": "她在一家外资企业工作，待遇很好。", "example_pinyin": "Tā zài yī jiā wàizī qǐyè gōngzuò, dàiyù hěn hǎo.", "example_en": "She works at a foreign-funded enterprise with good benefits.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "展览": {"chinese": "展览", "pinyin": "zhǎn lǎn", "meaning": "exhibition; display; show", "example_zh": "我们周末去看了一个艺术展览。", "example_pinyin": "Wǒmen zhōumò qù kàn le yī gè yìshù zhǎnlǎn.", "example_en": "We went to see an art exhibition on the weekend.", "interval": 8, "ease": 2.5, "due": "2026-06-18", "reps": 3}, "分公司": {"chinese": "分公司", "pinyin": "fēn gōng sī", "meaning": "branch company; subsidiary office", "example_zh": "我们公司在上海开了一家分公司。", "example_pinyin": "Wǒmen gōngsī zài Shànghǎi kāi le yī jiā fēn gōngsī.", "example_en": "Our company opened a branch office in Shanghai.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "业务": {"chinese": "业务", "pinyin": "yè wù", "meaning": "business; professional work; operations", "example_zh": "他负责公司的海外业务。", "example_pinyin": "Tā fùzé gōngsī de hǎiwài yèwù.", "example_en": "He is in charge of the company's overseas business operations.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "公正": {"chinese": "公正", "pinyin": "gōng zhèng", "meaning": "fair; just; impartial", "example_zh": "法官必须保持公正，不偏袒任何一方。", "example_pinyin": "Fǎguān bìxū bǎochí gōngzhèng, bù piāntān rènhé yī fāng.", "example_en": "A judge must remain impartial and not favor either side.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "待遇": {"chinese": "待遇", "pinyin": "dài yù", "meaning": "treatment; pay and benefits; conditions", "example_zh": "这家公司的待遇很好，员工都很满意。", "example_pinyin": "Zhè jiā gōngsī de dàiyù hěn hǎo, yuángōng dōu hěn mǎnyì.", "example_en": "This company offers good benefits and all employees are satisfied.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "指标": {"chinese": "指标", "pinyin": "zhǐ biāo", "meaning": "indicator; target; metric; quota", "example_zh": "这个季度我们没有完成销售指标。", "example_pinyin": "Zhège jìdù wǒmen méiyǒu wánchéng xiāoshòu zhǐbiāo.", "example_en": "We did not meet our sales target this quarter.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "隐晦": {"chinese": "隐晦", "pinyin": "yǐn huì", "meaning": "obscure; indirect; veiled; ambiguous", "example_zh": "他说话总是很隐晦，让人猜不透他的意思。", "example_pinyin": "Tā shuōhuà zǒng shì hěn yǐnhuì, ràng rén cāi bù tòu tā de yìsi.", "example_en": "He always speaks in a veiled way, making it hard to understand what he means.", "interval": 8, "ease": 2.5, "due": "2026-06-15", "reps": 3}, "服从": {"chinese": "服从", "pinyin": "fú cóng", "meaning": "to obey; to comply with; to submit to", "example_zh": "士兵必须服从命令。", "example_pinyin": "Shìbīng bìxū fúcóng mìnglìng.", "example_en": "Soldiers must obey orders.", "interval": 3, "ease": 2.5, "due": "2026-06-12", "reps": 2}, "确信": {"chinese": "确信", "pinyin": "què xìn", "meaning": "to be certain; to be convinced; to firmly believe", "exam